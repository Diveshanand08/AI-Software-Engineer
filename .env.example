# ==============================================================================
# AI SOFTWARE ENGINEER ASSISTANT - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LLM Provider API Keys (At least one cloud provider or local Ollama is required)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# GitHub Integration (Required for opening Automated Pull Requests)
GITHUB_TOKEN=your_github_personal_access_token_here

# Local Ollama Configuration (Fallback/Local LLM execution)
OLLAMA_BASE_URL=http://127.0.0.1:11434
DEFAULT_OLLAMA_MODEL=phi3
EMBED_MODEL=nomic-embed-text

# Storage & Persistence Paths
CHROMA_DIR=./chroma_db
CLONE_DIR=./_cloned_repos
DB_PATH=./chat_history.db

# Indexing & Retrieval Limits
MAX_CHUNKS_PER_REPO=800
DEFAULT_RETRIEVAL_K=6
GIT_CLONE_TIMEOUT_SECONDS=600
